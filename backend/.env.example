# Server
HOST=0.0.0.0
PORT=5000
DEBUG=false

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_PATH=database/cybersentinel.db

# Scan artifacts (generated PDF reports)
SCANS_DIR=scans

# Logging
LOG_LEVEL=INFO
LOG_FILE=cybersentinel.log

# Port Scanner
# Keep this bounded for HTTP-request-scoped scans; widen only in trusted/offline environments.
NMAP_PORT_RANGE=21-23,25,53,80,110,135,139,143,443,445,3306,3389,5432,8080,8443
NMAP_ARGS=-sT -T4 --reason --host-timeout 20s
NMAP_TIMEOUT_SECONDS=45

# OS Detection (nmap -O) — a SEPARATE, isolated, best-effort probe from the
# main port scan above. Requires root; silently returns no OS guess (never
# breaks the port scan) when run without it. See backend/README.md.
NMAP_OS_DETECTION_ARGS=-O --osscan-guess --max-os-tries 1 --host-timeout 15s
NMAP_OS_DETECTION_TIMEOUT_SECONDS=20

# HTTP-based modules (Vulnerability Scanner, Technology Fingerprinting)
HTTP_TIMEOUT_SECONDS=8
HTTP_USER_AGENT=CyberSentinelAI-Scanner/1.0 (+https://cybersentinel.local)

# SSL Analyzer
SSL_TIMEOUT_SECONDS=6
SSL_RETRY_ON_TIMEOUT=true
SSL_CHAIN_TIMEOUT_SECONDS=8

# Scan orchestration — all 6 modules run concurrently in a thread pool
# (they're mutually independent I/O-bound calls). Cap at the number of
# modules that can ever run in one scan.
SCAN_MAX_WORKERS=6

# Rate limiting (Flask-Limiter). In-memory by default; point at Redis
# (e.g. redis://localhost:6379) for multi-worker production deployments.
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=60 per minute
RATELIMIT_SCAN=5 per minute
