# Example environment variables for CyberSentinel AI
# Copy to .env and edit as needed. Do NOT commit secrets.

# Server
HOST=0.0.0.0
PORT=5000
DEBUG=false

# CORS (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=60 per minute
RATELIMIT_SCAN=5 per minute

# Database / storage
DATABASE_PATH=backend/database/cybersentinel.db
SCANS_DIR=backend/scans

# Logging
LOG_LEVEL=INFO
LOG_FILE=backend/cybersentinel.log

# Nmap defaults (bounded by default for reasonable latency)
NMAP_PORT_RANGE=21-23,25,53,80,110,135,139,143,443,445,3306,3389,5432,8080,8443
NMAP_ARGS=-sT -sV -T4 --reason --version-intensity 2 --host-timeout 40s
NMAP_TIMEOUT_SECONDS=55

# HTTP fetch settings
HTTP_TIMEOUT_SECONDS=8
HTTP_USER_AGENT=CyberSentinelAI-Scanner/1.0 (+https://cybersentinel.local)

# SSL
SSL_TIMEOUT_SECONDS=6
SSL_RETRY_ON_TIMEOUT=true
SSL_CHAIN_TIMEOUT_SECONDS=8

# Concurrency
SCAN_MAX_WORKERS=6
