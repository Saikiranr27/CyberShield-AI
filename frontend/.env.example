# Base URL of the running Flask backend (see /backend).
# Must include the "/api" prefix, matching the backend's blueprint routes.
VITE_API_BASE_URL=http://localhost:5000/api

# The frontend talks to the real backend above by default. Set to "true"
# only for offline UI development without a running Flask server — mock
# mode has no port scanning, DNS/WHOIS, SSL, or PDF generation; it's a
# lightweight visual stand-in only.
VITE_MOCK_MODE=false
